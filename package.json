{
  "name": "spotify-widget",
  "version": "1.0.0",
  "description": "Electron app to display the currently playing Spotify song.",
  "main": "main.js",
  "author": "Ton Nom",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.yourname.spotifywidget",
    "productName": "Spotify Widget",
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "mac": { 
      "target": "dmg",
      "icon": "assets/icon.icns"
      } ,
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "dotenv": "^17.4.2"
  }
}